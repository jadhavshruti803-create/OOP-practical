#include <iostream>
#include <string>
using namespace std;

class Employee {
private:
    string name;
    int id;

public:
    // Constructor
    Employee(string n, int i) {
        name = n;
        id = i;
        cout << "Employee record created for " << name << endl;
    }

    // Destructor
    ~Employee() {
        cout << "Employee record removed for " << name << endl;
    }

    void display() {
        cout << "Employee ID: " << id << endl;
        cout << "Employee Name: " << name << endl;
    }
};

int main() {
    {
        Employee emp("Rahul", 101);
        emp.display();

        cout << "Recruitment data processing completed." << endl;
    } // Destructor is automatically called here

    cout << "Program completed." << endl;

    return 0;
    
}