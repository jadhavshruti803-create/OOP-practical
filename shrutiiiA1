#include <iostream>
#include <string>
using namespace std;

class book 
{
    private:
    string title;
    string author;
    string isbn;
    double price;

    public:
    // Function to record book information 

    void recordBook()
    {
        cout <<"Enter Book Title:";
        getline(cin, title);

        cout <<"Enter author Name";
        getline(cin, author);

        cout <<"Enter ISBN:";
        getline(cin, isbn);

        cout <<"Enter Price:";
        cin >> price;
        cin.ignore();
    }
    // Function to display book info

    void displayBook()
    {
        cout << "\n --- Book Information ---"<< endl;
        cout << "Title:" << title << endl;
        cout << "Author:" << author << endl;
        cout << "ISBN:" << isbn << endl;
        cout << " Price:" << price << endl;
    }
};