#include <iostream>
#include <string>
using namespace std;

class Book {
private:
    string title;
    string author;
    double price;

public:
    // Default constructor
    Book() {
        title = "Unknown";
        author = "Unknown";
        price = 0.0;
    }

    // Parameterized constructor
    Book(string title, string author, double price) {
        this->title = title;
        this->author = author;
        this->price = price;
    }

    // Display book details
    void display() {
        cout << "Title: " << title << endl;
        cout << "Author: " << author << endl;
        cout << "Price: " << price << endl;
    }
};

int main() {
    // Book with default details
    Book book1;

    // Book with complete information
    Book book2("The Alchemist", "Paulo Coelho", 399.0);

    cout << "Book 1:" << endl;
    book1.display();

    cout << "\nBook 2:" << endl;
    book2.display();

    return 0;
}       

























 